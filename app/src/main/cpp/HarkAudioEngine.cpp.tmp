void HarkAudioEngine::logLatencyStatistics() {
    if (!mIsRunning || !mInputStream || !mOutputStream) {
        LOGD("Latency stats: Engine not running.");
        return;
    }

    // 1. 理論軟體延遲 (基於緩衝區大小)
    double sampleRate = mOutputStream->getSampleRate();
    double bufferSize = (double)mOutputStream->getBufferSizeInFrames();
    double softwareLatencyMs = (bufferSize / sampleRate) * 1000.0;

    // 2. 估算端到端延遲 (基於輸入/輸出框差)
    // 算法：(輸出寫入框數 - 輸入讀取框數) / 採樣率
    int64_t framesWritten = mOutputStream->getFramesWritten();
    int64_t framesRead = mInputStream->getFramesRead();
    double diffFrames = (double)(framesWritten - framesRead);
    double estimatedRtlMs = (diffFrames / sampleRate) * 1000.0;

    // 3. 取得系統 XRun (斷音次數) 統計
    int32_t xRuns = mOutputStream->getXRunCount().value_or(0);

    LOGD("--- Hark Latency Audit ---");
    LOGD("Sample Rate: %.0f Hz", sampleRate);
    LOGD("Buffer Size: %.0f frames", bufferSize);
    LOGD("Software Latency: %.2f ms", softwareLatencyMs);
    LOGD("Estimated Round-Trip: %.2f ms", estimatedRtlMs);
    LOGD("Stream Stability (XRuns): %d", xRuns);
    LOGD("--------------------------");
}
