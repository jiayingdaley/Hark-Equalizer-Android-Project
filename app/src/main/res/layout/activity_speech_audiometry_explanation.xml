<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".SpeechAudiometryExplanationActivity">

    <TextView
        android:id="@+id/textViewExplanationTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="為什麼還要做語詞測試？"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textViewExplanationBody"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="剛剛已經根據你的聽力狀況，調整耳機的聲音。\n\n接下來的語詞測試，是為了確認你實際是否聽懂說話的效果。\n\n這可以進一步確認，聲音的調整是否適合你，以在日常生活當中順利對話。"
        android:textSize="18sp"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toBottomOf="@id/textViewExplanationTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.9" />

    <Button
        android:id="@+id/buttonStartVolumeAdjustment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OK"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>