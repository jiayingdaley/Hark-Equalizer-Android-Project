<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:fitsSystemWindows="true"
    android:background="#F5F7FA">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/buttonSsnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="結束並返回"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="噪音下語詞測驗"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212121" />
    </FrameLayout>

    <TextView
        android:id="@+id/textViewSsnQuestionCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:text="00 / 00"
        android:textSize="16sp"
        android:textColor="#616161" />

    <TextView
        android:id="@+id/textViewSsnSnr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text=""
        android:textSize="14sp"
        android:textColor="#1976D2" />

    <TextView
        android:id="@+id/textViewSsnDspStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="2dp"
        android:text=""
        android:textSize="13sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressBarSsn"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="請選出您聽到的語詞"
        android:textSize="16sp"
        android:textColor="#424242" />

    <TextView
        android:id="@+id/textViewSsnPlaying"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="🔊 播放中，請仔細聆聽…"
        android:textSize="15sp"
        android:textColor="#00796B"
        android:visibility="invisible"
        android:layout_marginBottom="4dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:columnCount="2"
        android:rowCount="2">

        <Button
            android:id="@+id/buttonSsnOption1"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:textSize="22sp"
        android:background="@drawable/rounded_button" />

        <Button
            android:id="@+id/buttonSsnOption2"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:textSize="22sp"
        android:background="@drawable/rounded_button" />

        <Button
            android:id="@+id/buttonSsnOption3"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:textSize="22sp"
        android:background="@drawable/rounded_button" />

        <Button
            android:id="@+id/buttonSsnOption4"
            android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            android:textSize="22sp"
        android:background="@drawable/rounded_button" />
    </GridLayout>

    <Button
        android:id="@+id/buttonSsnNotSure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_marginTop="8dp"
        android:text="不確定"
        android:textColor="#546E7A"
        android:background="@drawable/outlined_button" />

</LinearLayout>
