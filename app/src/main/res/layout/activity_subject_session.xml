<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="測試者測驗流程"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="快速純音（自調式）→ 套用 DSL v5 → 噪音下語詞 A/B 對照 → 環境輔聽問卷 → 匯出"
            android:textSize="14sp"
            android:textColor="#666666" />

        <EditText
            android:id="@+id/editSessionSubjectName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="測試者 ID / 姓名"
            android:inputType="textPersonName"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="耳機型號"
            android:textSize="14sp" />

        <Spinner
            android:id="@+id/spinnerSessionEarphone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="28dp">

            <TextView android:id="@+id/stepText1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="① 快速純音（自調式）" android:textSize="16sp" android:textStyle="bold" android:padding="4dp" />
            <TextView android:id="@+id/stepText2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="② 套用 DSL v5 處方" android:textSize="16sp" android:textStyle="bold" android:padding="4dp" android:alpha="0.4" />
            <TextView android:id="@+id/stepText3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="③ 噪音下語詞 A/B 對照" android:textSize="16sp" android:textStyle="bold" android:padding="4dp" android:alpha="0.4" />
            <TextView android:id="@+id/stepText4" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="④ 環境輔聽問卷" android:textSize="16sp" android:textStyle="bold" android:padding="4dp" android:alpha="0.4" />
            <TextView android:id="@+id/stepText5" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="⑤ 完成 / 匯出" android:textSize="16sp" android:textStyle="bold" android:padding="4dp" android:alpha="0.4" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="若某步驟測得不理想，可在此重新測試該步驟（不影響已完成的其他步驟）："
            android:textSize="13sp"
            android:textColor="#666666" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:weightSum="3">

            <Button
                android:id="@+id/buttonRetestPta"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="重測①純音"
                android:textSize="12sp"
                android:background="@drawable/rounded_button"
                android:enabled="false" />

            <Button
                android:id="@+id/buttonRetestAb"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="重測③A/B"
                android:textSize="12sp"
                android:background="@drawable/rounded_button"
                android:enabled="false" />

            <Button
                android:id="@+id/buttonRetestQuestionnaire"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="重測④問卷"
                android:textSize="12sp"
                android:background="@drawable/rounded_button"
                android:enabled="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/textSessionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text=""
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <Button
            android:id="@+id/buttonSessionNext"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="28dp"
            android:text="開始"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/rounded_button" />

        <Button
            android:id="@+id/buttonSessionExport"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="匯出測試者資料"
            android:textSize="16sp"
            android:background="@drawable/rounded_button"
            android:visibility="gone" />

        <Button
            android:id="@+id/buttonSessionHistory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="測試者測驗歷史"
            android:textSize="15sp"
            android:background="@drawable/rounded_button" />
    </LinearLayout>
</ScrollView>
