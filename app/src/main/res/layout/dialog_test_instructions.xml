<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textViewDialogTitleInstructions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="測驗進行方式"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/buttonCloseInstructionsDialog"
            app:layout_constraintBottom_toBottomOf="@id/buttonCloseInstructionsDialog"/>

        <ImageButton
            android:id="@+id/buttonCloseInstructionsDialog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            app:tint="?android:attr/textColorSecondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/textViewInstructionsBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="總共會有25題，會播放一雙字詞，請四選一。\n若不確定請選擇「我不確定」"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:lineSpacingExtra="4dp"/>

    <Button
        android:id="@+id/buttonStartSrtTest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Test"
        android:textSize="18sp"
        android:layout_gravity="center_horizontal"/>

</LinearLayout>